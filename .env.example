# ── apps/api ──
# Port API proxy
PORT=8787

# ── apps/web ──
# Base URL API. Kosongkan bila pakai proxy Vite dev (default /api).
# Isi saat build produksi yang memanggil API di domain terpisah.
# VITE_API_URL=

# Target upstream passthrough (opsional, default pakai katalog)
# SIPUTZX_BASE=
# KYZZNEKOO_BASE=