#!/usr/bin/env bash
# Auto-sync codegraph setelah commit/merge/checkout — jaga index gak stale.
# Berjalan di background, gak nge-block git.

# cek codegraph terinstall
command -v codegraph >/dev/null 2>&1 || exit 0

# cek .codegraph ada di root repo
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -d "$GIT_ROOT/.codegraph" ] || exit 0

# sync di background, log ke file (gakganggu commit)
(
  cd "$GIT_ROOT" || exit 0
  codegraph sync >/tmp/codegraph-sync.log 2>&1
) & disown

exit 0
